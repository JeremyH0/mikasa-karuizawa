---
import { locales, localeHref, localeName, useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();
const showLanguages = locales.length > 1;
---

<footer data-nav-dark class="bg-forest-deep px-6 py-16 md:px-10 lg:px-14">
    <div class="mx-auto max-w-shell">
        <div class="flex flex-col gap-10 border-b border-bone/12 pb-10 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="font-serif text-lg tracking-[0.26em] text-bone">OLD KARUIZAWA</p>
                <p class="mt-2 text-[0.65rem] tracking-[0.4em] text-bone/45">MIKASA</p>
            </div>

            {showLanguages && (
                <nav class="flex flex-wrap gap-x-7 gap-y-3" aria-label="Language">
                    {locales.map((l) => (
                        <a
                            href={localeHref(l)}
                            hreflang={l}
                            lang={l}
                            aria-current={l === locale ? 'true' : undefined}
                            class:list={[
                                'text-[0.72rem] tracking-[0.14em] transition-colors duration-300',
                                l === locale ? 'text-brass' : 'text-bone/45 hover:text-bone',
                            ]}
                        >
                            {localeName[l]}
                        </a>
                    ))}
                </nav>
            )}
        </div>

        <div class="mt-10 flex flex-col gap-8 md:flex-row md:justify-between">
            <p class="max-w-[68ch] text-[0.68rem] leading-relaxed text-bone/35">
                {t.footer.disclaimer}
            </p>

            <p class="shrink-0 text-[0.68rem] tracking-[0.1em] text-bone/45">
                © {year} {t.footer.company}. {t.footer.rights}
            </p>
        </div>

        {/* Back to top — a real anchor to #top, so it works with JavaScript
            disabled and is keyboard-reachable. motion.ts's anchor handler
            routes every `a[href^="#"]` through Lenis, so the return glides on
            the site's easing instead of jumping.

            It lives HERE rather than as a floating button on purpose. A disc
            pinned to the corner would sit over the photography for the whole
            page and collide with the first-visit language bar; at the end of
            the footer it is exactly where a reader who has finished the page
            looks for it, and it costs the layout nothing on the way down.

            The label rides the arrow's hover, and the ring picks up the brass
            fill used by the enquiry button, so it reads as part of the same
            set of controls. */}
        <div class="mt-12 flex justify-center border-t border-bone/12 pt-10 md:justify-end">
            <a
                href="#top"
                class="group inline-flex items-center gap-4 text-[0.68rem] tracking-[0.26em] uppercase text-bone/50 transition-colors duration-500 hover:text-brass"
            >
                {t.nav.backToTop}
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-bone/20 transition-colors duration-500 group-hover:border-brass/70">
                    <svg
                        viewBox="0 0 24 24"
                        class="h-3.5 w-3.5 transition-transform duration-500 ease-[var(--ease-estate)] group-hover:-translate-y-0.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 19V5m-7 7 7-7 7 7" />
                    </svg>
                </span>
            </a>
        </div>
    </div>
</footer>
