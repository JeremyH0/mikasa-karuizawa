---
// Page 4 of the deck: the Master Plan spread — one large aerial over a
// three-up band.
//
// ⚠️ TWO DIFFERENT BUILDINGS EXIST IN THE SUPPLIED MATERIAL. Read this before
// adding an image here.
//
// The deck (p.4) shows a SINGLE-STOREY, L-shaped pavilion with a broad hipped
// roof — `mikasa-photo-05/06/07/08`. **That is the scheme this site shows.**
//
// The Realize Co. drawings dated 2026.03.31–04.03 and the high-resolution
// renders `01.jpg` / `02.jpg` show a DIFFERENT, two-storey house (7.763 m to
// ridge, 379.88 m² total floor area). Those are deliberately NOT built — see
// the note in scripts/optimize-images.mjs. Do not mix the two sets: they are
// not the same house, and a buyer shown both would reasonably be misled.
//
// The deck's renders are also low-resolution — the three band images are only
// 678 px wide originals, which is why the band is capped at three narrow
// columns rather than run full-bleed. If better exports of THIS scheme arrive,
// they slot straight in under the same filenames.
//
// The deck presents these as finished photography, but they are renders of a
// house that does not exist on a plot being sold as bare land. Left
// unqualified that is a misrepresentation a buyer could rely on, so
// `t.concept.note` says plainly that the imagery is conceptual and that no
// building is included. Keep that note whatever else changes here.
import Figure from './Figure.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const band = [
    { src: '/images/villa-exterior.jpg', alt: t.concept.images.exterior, tone: 'forest' as const },
    { src: '/images/villa-bathroom.jpg', alt: t.concept.images.bathroom, tone: 'interior' as const },
    { src: '/images/villa-bedroom.jpg', alt: t.concept.images.bedroom, tone: 'interior' as const },
];
---

<section id="concept" data-nav-dark class="bg-forest-deep py-24 md:py-32 lg:py-40">
    <div class="mx-auto max-w-[1600px] px-6 md:px-10 lg:px-14">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:items-end lg:gap-20">
            <div>
                <div data-animate class="mb-8 h-px w-14 bg-brass" aria-hidden="true"></div>
                <p data-animate class="eyebrow text-brass">{t.concept.eyebrow}</p>
                <h2 data-lines class="display mt-6 max-w-[16ch] text-bone text-[clamp(1.75rem,3.4vw,2.9rem)]">
                    <span class="line-mask"><span>{t.concept.heading}</span></span>
                </h2>
            </div>

            <p
                data-animate
                data-animate-delay="0.15"
                class="max-w-[52ch] text-[0.95rem] leading-[1.85] text-bone/70"
            >
                {t.concept.body}
            </p>
        </div>

        {/* Hero render.

            The top scrim is not decoration. This is a gold section, and this
            plate scrolls beneath the header — gold over its sun-ray highlights
            measures 1.2:1, and reaching AA needs ~58% black. The gradient
            ramps to the section colour at the top edge, where gold reads 6.24
            against forest-deep, and clears the image entirely within 9rem.

            It also reads well on its own: the render emerges out of the
            section rather than being pasted onto it. */}
        <div class="relative mt-16 overflow-hidden md:mt-20">
            <Figure
                src="/images/villa-aerial.jpg"
                alt={t.concept.images.aerial}
                width={1658}
                height={1176}
                tone="forest"
                class="w-full"
                imgClass="h-full w-full object-cover"
                data-reveal-img
            />
            <div
                class="pointer-events-none absolute inset-x-0 top-0 h-36"
                style="background: linear-gradient(to bottom, #2A2F25 0%, rgba(42,47,37,0.72) 38%, rgba(42,47,37,0) 100%);"
            >
            </div>
        </div>

        {/* Three-up band */}
        <div class="mt-5 grid gap-5 sm:grid-cols-3">
            {band.map((img, i) => (
                <div class="overflow-hidden">
                    <Figure
                        src={img.src}
                        alt={img.alt}
                        width={678}
                        height={452}
                        tone={img.tone}
                        class="w-full"
                        imgClass="h-full w-full object-cover transition-transform duration-[1.6s] ease-[var(--ease-estate)] hover:scale-[1.04]"
                        data-reveal-img
                        data-animate-delay={String(i * 0.12)}
                    />
                </div>
            ))}
        </div>

        <p data-animate class="mt-10 max-w-[70ch] text-[0.7rem] leading-relaxed text-bone/40">
            {t.concept.note}
        </p>
    </div>
</section>
