---
// Page 2: the illustrated Karuizawa map with its three labelled points.
//
// REDESIGNED from inline text pills to NUMBERED MARKERS.
//
// The previous version anchored `whitespace-nowrap` text labels — "Karuizawa
// Station", or the equivalent in three other scripts — at percentage
// coordinates with no boundary clamping. On a narrow map (any phone, or the
// mobile stacked layout) that label routinely ran past the image edge, and
// on any screen it competed with the map artwork instead of sitting on it
// cleanly. There was no way to fix that by tuning numbers; the mechanism was
// wrong at any width.
//
// A numbered badge is a fixed, small, language-independent shape — a digit in
// a circle never overflows, at any viewport, in any of the four locales. The
// legend beneath the map and the travel-time list beside it are what carry
// the actual place names, cross-referenced to the map by the same numbers.
// This is the standard device for a site-context map in a property brochure,
// and it is also just more robust engineering: the one part that has to work
// at every width is now geometrically incapable of breaking.
//
// The map is presented as a framed plate (bordered panel, caption line, a
// corner compass mark) rather than a bare photo, echoing how the survey
// drawing is presented in Land.astro — the two "technical drawing" moments on
// the page now share one visual language.
import Figure from './Figure.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Coordinates are percentages over the image, matching the deck's artwork.
// If the map is ever re-cropped, these three pairs are the only thing to
// re-tune — see the same note kept on the pins themselves below.
const pins = [
    { n: 1, label: t.location.pins.site, x: 30, y: 22, primary: true },
    { n: 2, label: t.location.pins.ginza, x: 57, y: 62, primary: false },
    { n: 3, label: t.location.pins.station, x: 63, y: 86, primary: false },
];

// Travel times. Only ginza/station carry a map number — Tokyo and Haneda are
// off the illustration, so badging them would promise a pin that isn't there.
const times = [
    { ...t.location.times.ginza, n: 2 },
    { ...t.location.times.station, n: 3 },
    { ...t.location.times.tokyo, n: undefined },
    { ...t.location.times.haneda, n: undefined },
] as Array<{ label: string; value: string; via?: string; n?: number }>;
---

<section id="location" class="bg-bone-dim/60 py-24 md:py-32 lg:py-40">
    <div data-float-scene class="mx-auto max-w-shell px-6 md:px-10 lg:px-14">
        <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.45fr)] lg:gap-20 xl:gap-28">
            {/* Copy column */}
            <div data-float data-float-depth="0.18" class="lg:sticky lg:top-32 lg:self-start">
                <p data-animate class="eyebrow">{t.location.eyebrow}</p>

                <h2 data-lines class="display mt-6 max-w-[15ch] text-[clamp(1.75rem,3.4vw,2.9rem)]">
                    <span class="line-mask"><span>{t.location.heading}</span></span>
                </h2>

                <div data-animate data-animate-delay="0.1" class="mt-10 h-px w-16 bg-brass" aria-hidden="true"></div>

                <p
                    data-animate
                    data-animate-delay="0.15"
                    class="mt-10 max-w-[44ch] text-[0.95rem] leading-[1.85] text-ink/75"
                >
                    {t.location.body}
                </p>

                <dl class="mt-14 border-t border-ink/12">
                    {times.map((item, i) => (
                        <div
                            data-animate
                            data-animate-delay={String(0.2 + i * 0.06)}
                            class="flex items-baseline justify-between gap-6 border-b border-ink/12 py-5"
                        >
                            <dt class="flex items-baseline gap-3 text-[0.9rem] text-ink/75">
                                {/* Same numbered badge as the map pin it
                                    corresponds to — this is the cross-
                                    reference, not decoration. */}
                                {item.n && (
                                    <span
                                        aria-hidden="true"
                                        class="flex h-5 w-5 shrink-0 translate-y-0.5 items-center justify-center rounded-full border border-brass/50 text-[0.65rem] font-medium text-brass-dim"
                                    >
                                        {item.n}
                                    </span>
                                )}
                                <span>
                                    {item.label}
                                    {item.via && (
                                        <span class="mt-1 block text-[0.7rem] tracking-[0.08em] text-stone">
                                            {item.via}
                                        </span>
                                    )}
                                </span>
                            </dt>
                            <dd class="shrink-0 font-serif text-lg tracking-[0.08em] text-ink">
                                {item.value}
                            </dd>
                        </div>
                    ))}
                </dl>

                <p data-animate data-animate-delay="0.45" class="mt-5 text-[0.7rem] leading-relaxed text-stone">
                    {t.location.note}
                </p>
            </div>

            {/* Map column — a framed plate, not a bare photo. */}
            {/* The map plate, brought into the same mounted language as the
                photographs elsewhere: a gold hairline instead of the grey one
                it carried, and a slow drift toward the pointer on desktop.

                The inner bone padding STAYS. This is a drawing on a light
                ground, and it needs a mat between the artwork and the mount or
                the gold sits directly against the map's own cream and the two
                warm tones fight. Photographs need no mat; drawings on paper do.

                No slow zoom here either — same reason as the survey plan in
                Land.astro. A map that scales is a map whose scale bar lies. */}
            <div data-animate data-animate-delay="0.1">
                <div data-float data-float-depth="0.4" class="relative">
                <div
                    data-reveal-img
                    data-reveal-delay="0.22"
                    aria-hidden="true"
                    class="pointer-events-none absolute -inset-[1.5px] hidden bg-brass lg:block"
                >
                </div>
                <div class="relative bg-bone p-3 shadow-[0_30px_60px_-30px_rgba(38,38,31,0.35)] sm:p-4">
                    <div class="relative overflow-hidden">
                        <Figure
                            src="/images/location-map.jpg"
                            alt={t.location.mapAlt}
                            width={1600}
                            height={1200}
                            tone="stone"
                            class="w-full"
                            imgClass="h-full w-full object-cover"
                        />

                        {/* Compass mark — echoes the deck's own map artwork,
                            which carries the same device in its corner. Purely
                            decorative: the map already has a real orientation,
                            this just makes the plate read as a drawing rather
                            than a cropped screenshot. */}
                        <div
                            aria-hidden="true"
                            class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full border border-bone/70 bg-forest-deep/55 backdrop-blur-sm sm:right-4 sm:top-4"
                        >
                            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-bone">
                                <path d="M12 2 9.4 11 12 22 14.6 11Z" opacity="0.55" />
                                <path d="M12 4.2 10.4 11 12 17.5 13.6 11Z" />
                            </svg>
                        </div>

                        {/* Pin overlay. aria-hidden because every label is
                            already in the map's alt text and the travel-time
                            list — a screen reader announcing the numbers
                            again adds nothing. */}
                        <div class="absolute inset-0" aria-hidden="true">
                            {pins.map((pin, i) => (
                                <div
                                    class="pin absolute flex items-center justify-center"
                                    style={`left:${pin.x}%; top:${pin.y}%; --pin-delay:${0.4 + i * 0.18}s`}
                                >
                                    <span
                                        class:list={[
                                            'pin-mark relative flex items-center justify-center rounded-full font-serif shadow-[0_6px_18px_-4px_rgba(20,23,17,0.55)]',
                                            pin.primary
                                                ? 'h-8 w-8 border-2 border-brass bg-forest-deep text-sm text-bone sm:h-9 sm:w-9'
                                                : 'h-6 w-6 border border-bone/70 bg-forest text-[0.7rem] text-bone/95 sm:h-7 sm:w-7',
                                        ]}
                                    >
                                        {pin.n}
                                        {pin.primary && <span class="pin-pulse absolute inset-0 rounded-full border border-brass"></span>}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Legend — ties the map's numbers to the place names,
                        which is what used to sit unclamped on the image
                        itself. Wraps freely at any width because it is a
                        normal text row, not an absolutely-positioned label. */}
                    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 px-1 pt-3 sm:mt-4 sm:pt-4">
                        {pins.map((pin) => (
                            <div class="flex items-center gap-2.5">
                                <span
                                    aria-hidden="true"
                                    class:list={[
                                        'flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[0.65rem] font-serif',
                                        pin.primary
                                            ? 'border-2 border-brass bg-forest-deep text-bone'
                                            : 'border border-ink/25 text-ink/70',
                                    ]}
                                >
                                    {pin.n}
                                </span>
                                <span class="text-[0.78rem] tracking-[0.02em] text-ink/75">{pin.label}</span>
                            </div>
                        ))}
                    </div>
                </div>
                </div>

                <p class="mt-4 text-[0.7rem] leading-relaxed text-stone">
                    {t.location.mapCaption}
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Pins drop in on a stagger driven by the inline --pin-delay. Kept in CSS
       rather than GSAP because they are purely decorative and should not cost
       a ScrollTrigger each. Centred on their coordinate now (-50%/-50%), not
       offset, because a numbered badge — unlike the old left-anchored label —
       has no directional "tail" that needs the anchor pulled left. */
    .pin {
        transform: translate(-50%, -50%);
        opacity: 0;
        animation: pin-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: var(--pin-delay, 0s);
    }

    @keyframes pin-in {
        from {
            opacity: 0;
            transform: translate(-50%, calc(-50% - 10px));
        }
        to {
            opacity: 1;
            transform: translate(-50%, -50%);
        }
    }

    .pin-pulse {
        animation: pin-pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pin-pulse {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }
        70%,
        100% {
            transform: scale(1.9);
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pin {
            opacity: 1;
            animation: none;
        }
        .pin-pulse {
            animation: none;
            opacity: 0;
        }
    }
</style>
