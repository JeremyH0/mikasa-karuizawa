---
// The four feature marks from page 1 of the deck.
//
// These are the ORIGINAL vector files supplied with the marketing material
// (src/assets/images/icon-*.svg), inlined verbatim rather than redrawn, so the
// site and the printed deck show the identical mark. Do not "tidy" the path
// data — it is the source artwork.
//
// Two changes only, both so the caller controls appearance:
//   · the hardcoded stroke colour (#B6A69A / #C8B9A1) is stripped
//   · fill is currentColor, so the brass tone comes from the parent
//
// They are filled outline shapes, not strokes, hence fill-rule="evenodd" —
// without it the counters (the hole in the marker, the gaps between trunks)
// fill solid.
//
// Inlined rather than <img src>, so there is no extra request per icon and the
// colour can respond to the surrounding theme.

interface Props {
    name: 'district' | 'privacy' | 'greenery' | 'ginza';
    class?: string;
}

// district → marker · privacy → world · greenery → forest scene · ginza → map compass
const { name, class: className = "h-9 w-9" } = Astro.props;
