---
// Page 1 right-hand panel: the "Old Karuizawa" copy block and its four
// icon features, paired here with the tree-lined lane plate from page 2.
import Figure from './Figure.astro';
import FeatureIcon from './FeatureIcon.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The four marks from the deck — pin, globe, forest, compass rose. Geometry
// lives in FeatureIcon.astro; see the style rules at the top of that file
// before drawing a fifth.
const features = [
    { key: 'district', label: t.overview.features.district },
    { key: 'privacy', label: t.overview.features.privacy },
    { key: 'greenery', label: t.overview.features.greenery },
    { key: 'ginza', label: t.overview.features.ginza },
] as const;
---

{/* Forest green, continuing the hero's darkness rather than cutting straight
    to bone — the eye stays in the woodland for one more section before the
    page opens up at Location. Marked dark full-width, so the header flips its
    whole bar here, not just the wordmark.

    CONTAINED, not full-bleed. This section used to run its grid edge to edge,
    which put the lane photograph flush against the left of the window while
    every other section on the page — and the header floating above it — sat
    inside the shared `max-w-shell` gutter. The picture read as having fallen
    off the layout. It now sits in the same margin as everything else, which is
    also what lets the gold mount show on all four sides instead of three.

    Containing it retires a second workaround too: the old absolute inset that
    held the plate 7rem down from the section top. That existed because gold
    header text over this canopy measures 1.0:1, so a band of flat green had to
    be kept under the bar. The section's own top padding does that now. */}
<section id="overview" data-nav-dark class="relative bg-forest py-24 md:py-32 lg:py-40">
    <div class="mx-auto max-w-shell px-6 md:px-10 lg:px-14">
        <div data-float-scene class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-20 xl:gap-28">
        {/* The approach lane. Left column on desktop, BELOW the copy on
            everything smaller — see the ordering note on the copy block.

            Same treatment as the Concept plates: hairline gold mount, pointer
            drift, slow zoom inside a fixed frame. The two dark sections share
            one visual language for photography rather than each having its own.

            The float depth is low (0.45). This plate is nearly a full column
            tall, and a large element travelling as far as a small one reads as
            the whole layout sliding rather than as a picture with weight.

            The height is FIXED at every breakpoint, and the crop therefore
            changes with the window: 0.76 portrait at 1440, squaring up as the
            column widens. A 4:5 aspect-ratio version was built, which holds the
            lane's vertical composition at any width — but it also grows the
            plate past 1000px tall on a wide screen, and it was preferred this
            way.

            ⚠️ The consequence to know: past roughly 1700px the image column is
            wider than 800px and this plate stops being portrait. The lane runs
            away from the viewer, so it is a composition that wants height; if
            it ever looks cropped on a very wide monitor, `lg:aspect-[4/5]`
            with `h-auto` is the fix, paired with a max-width on the grid so the
            plate cannot tower over the copy beside it.

            Below lg the cap earns its place outright: full width and left to a
            4:5 ratio, this renders over 1100px tall on a tablet — one
            supporting photograph becoming a full screen of scrolling.

            data-parallax-img is gone — it did the fade-in AND its own vertical
            drift, which would fight the drift initFloat applies. The fade is
            not lost: the mount and the picture each carry the curtain wipe, the
            mount a fifth of a second behind. */}
        <div
            class="relative order-2 h-[52svh] max-h-[30rem] min-h-[17rem] md:h-[46svh] md:max-h-[34rem] lg:order-1 lg:h-[46rem] lg:max-h-none xl:h-[50rem]"
        >
            <div
                data-float
                data-float-depth="0.45"
                class="relative h-full w-full"
            >
                {/* The gold mount. Same 1.5px hairline as Concept.astro — see
                    the long note there for why it is a separate layer, why it
                    does not drift on its own, and why 1.5 and not 1. */}
                <div
                    data-reveal-img
                    data-reveal-delay="0.22"
                    aria-hidden="true"
                    class="pointer-events-none absolute -inset-[1.5px] hidden bg-brass shadow-[0_40px_90px_-40px_rgba(0,0,0,0.85)] lg:block"
                >
                </div>

                <div class="relative h-full w-full overflow-hidden">
                    <Figure
                        src="/images/approach-lane.jpg"
                        alt={t.overview.imageAlt}
                        width={1200}
                        height={1600}
                        tone="forest"
                        class="h-full w-full"
                        imgClass="h-full w-full object-cover"
                        data-reveal-img
                        data-float-zoom
                    />
                </div>
            </div>
        </div>

        {/* Copy. Right column on desktop, FIRST on phone and tablet.

            Stacking in DOM order put two photographs back to back — the
            full-bleed hero, then a tall portrait plate — and pushed the first
            words of the page roughly a screen and a half down. The section
            that has to say what this place is was arriving after the reader
            had already scrolled past two forests.

            `order` only moves the visual box; the DOM order is unchanged, so
            the reading and tab order stay correct at every width. The desktop
            composition (image left, copy right) is restored at lg. */}
        {/* ONE MEASURE for the whole copy stack — this is the balance fix.

            The three blocks used to size themselves independently: the heading
            filled the column at 673px, the body stopped at a 46ch measure
            around 427px, and the feature list ran wider than both. Three
            different right edges inside one column is what made this section
            read as unbalanced — the eye looks for a column and finds a ragged
            shape, and the leftover width reads as a hole rather than a margin.

            34rem is now the measure for all of it: eyebrow, heading, rule, body
            and features share one left edge AND one right edge. What is left of
            the column past that is a clean margin, which is what the eye
            expects to see beside a set column.

            34rem (544px) is also a good measure in its own right — roughly
            58 characters at this size, inside the comfortable band. The
            `max-w-[46ch]` and `max-w-[18ch]` on the children still apply below
            lg, where the block is the full width of the page and needs its own
            constraint; at lg they defer to this wrapper.

            Below lg the wrapper is centred instead, which turns the leftover
            tablet width into two even margins. */}
        <div class="order-1 flex flex-col justify-center lg:order-2">
            <div data-float data-float-depth="0.18" class="mx-auto w-full max-w-2xl lg:mx-0 lg:max-w-[34rem]">
                <p data-animate class="eyebrow text-brass">{t.overview.eyebrow}</p>

                <h2
                    data-lines
                    class="display mt-6 max-w-[18ch] text-bone text-[clamp(1.75rem,3.4vw,2.9rem)] lg:max-w-none"
                >
                    <span class="line-mask"><span>{t.overview.heading}</span></span>
                </h2>

                <div
                    data-animate
                    data-animate-delay="0.1"
                    class="mt-10 h-px w-16 bg-brass"
                    aria-hidden="true"
                >
                </div>

                {/* Measure opens up slightly on tablet, where this paragraph is
                    the full width of the page rather than a column beside a
                    picture. */}
                <div class="mt-10 max-w-[46ch] space-y-6 text-[0.95rem] leading-[1.85] text-bone/70 md:max-w-[56ch] lg:max-w-none">
                    <p data-animate data-animate-delay="0.15">{t.overview.body1}</p>
                    <p data-animate data-animate-delay="0.22">{t.overview.body2}</p>
                </div>

                {/* Two-up between sm and lg. These are four short, unranked
                    labels; as a single column they left most of a tablet's
                    width empty and stretched the section by another screen.
                    They go back to one column at lg, where the copy is already
                    sharing the page with the photograph. */}
                <ul class="mt-14 grid gap-7 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-1">
                    {features.map((feature, i) => (
                        <li
                            data-animate
                            data-animate-delay={String(0.3 + i * 0.07)}
                            class="flex items-start gap-5"
                        >
                            <span class="mt-0.5 shrink-0 text-brass">
                                <FeatureIcon name={feature.key} class="h-9 w-9" />
                            </span>
                            <span class="pt-1.5 text-[0.9rem] leading-relaxed text-bone/80">
                                {feature.label}
                            </span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
        </div>
    </div>
</section>
