# Copy to `.env.deploy` and fill in. `.env.deploy` is gitignored — never commit
# the real values. Consumed by scripts/deploy.sh (`npm run deploy`).
#
# Xserver gives you SSH once it is enabled in the server panel
# (サーバーパネル → SSH設定 → ON) and your public key is registered.
# The port is 10022, not 22.

# Xserver SSH host — usually <account>.xsrv.jp, or sv####.xserver.jp
DEPLOY_HOST=example.xsrv.jp

# Xserver account name (the SSH user is the account, not the domain)
DEPLOY_USER=youraccount

# Absolute path to the docroot on the server. Xserver's layout is:
#   /home/<account>/<domain>/public_html
DEPLOY_PATH=/home/youraccount/mikasa-karuizawa.com/public_html

# Xserver SSH listens on 10022
DEPLOY_SSH_PORT=10022

# "true" removes remote files that are no longer in dist/.
# Leave false until you have confirmed the docroot holds nothing else you need
# — with a domain that previously ran WordPress, this deletes it permanently.
DEPLOY_DELETE=false

# Astro `base`. Leave unset or "/" for a production deploy at the docroot.
# Set to e.g. /staging ONLY when DEPLOY_PATH points at a subfolder.
# BASE_PATH=/staging

# Absolute SERVER path to a .htpasswd file, used to password-protect STAGING
# builds only (deploy.sh refuses to apply it to a root deploy). Keep it outside
# public_html so it is never web-readable.
# AUTH_USER_FILE=/home/youraccount/.htpasswd-mikasa
