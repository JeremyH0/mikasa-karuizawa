---
// Page 1 right-hand panel: the "Old Karuizawa" copy block and its four
// icon features, paired here with the tree-lined lane plate from page 2.
import Figure from './Figure.astro';
import FeatureIcon from './FeatureIcon.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The four marks from the deck — pin, globe, forest, compass rose. Geometry
// lives in FeatureIcon.astro; see the style rules at the top of that file
// before drawing a fifth.
const features = [
    { key: 'district', label: t.overview.features.district },
    { key: 'privacy', label: t.overview.features.privacy },
    { key: 'greenery', label: t.overview.features.greenery },
    { key: 'ginza', label: t.overview.features.ginza },
] as const;
---

{/* Forest green, continuing the hero's darkness rather than cutting straight
    to bone — the eye stays in the woodland for one more section before the
    page opens up at Location. Marked dark full-width: the left half is the
    (dark) lane photograph and the right half is this panel, so the header
    flips its whole bar here, not just the wordmark. */}
<section id="overview" data-nav-dark class="relative bg-forest">
    <div class="grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]">
        {/* The approach lane. Left column on desktop, BELOW the copy on
            everything smaller — see the ordering note on the copy block.

            ── Desktop: inset from the top rather than run full-bleed, so a
            band of forest green always sits beneath the header. That is
            deliberate and load-bearing: this is a gold section, and gold over
            this plate measures 1.0:1 — the canopy has bright sky gaps in
            exactly the band the bar occupies. Pulling gold up to AA over it
            would need a 72% black scrim, which would kill the photograph.

            Letting the green run behind the header instead costs nothing and
            reads as intentional — the image sits within the green field
            rather than colliding with the section edge. Keep the inset at
            least as tall as the header (~72px) if these values are retuned.

            ── Below lg the same problem solves itself: the copy is what meets
            the header now, and that is flat forest green, which is the exact
            background the nav gold was measured against. So no inset is
            needed here, and the old `pt-20` that provided it is gone.

            The height is CAPPED below lg. This is a 3:4 portrait plate; left
            to its own aspect ratio it renders 520px tall on a phone and over
            1100px on a tablet, which turned one supporting photograph into a
            full screen of scrolling. A fixed band with object-cover keeps the
            lane's vertical composition while holding it to a readable share
            of the page. */}
        <div class="relative order-2 h-[52svh] max-h-[30rem] min-h-[17rem] overflow-hidden md:h-[46svh] md:max-h-[34rem] lg:order-1 lg:h-auto lg:max-h-none lg:min-h-[46rem]">
            <Figure
                src="/images/approach-lane.jpg"
                alt={t.overview.imageAlt}
                width={1200}
                height={1600}
                tone="forest"
                class="h-full w-full lg:absolute lg:inset-x-0 lg:bottom-0 lg:top-28"
                imgClass="h-full w-full object-cover"
                data-parallax-img
                data-parallax-depth="10"
            />
        </div>

        {/* Copy. Right column on desktop, FIRST on phone and tablet.

            Stacking in DOM order put two photographs back to back — the
            full-bleed hero, then a tall portrait plate — and pushed the first
            words of the page roughly a screen and a half down. The section
            that has to say what this place is was arriving after the reader
            had already scrolled past two forests.

            `order` only moves the visual box; the DOM order is unchanged, so
            the reading and tab order stay correct at every width. The desktop
            composition (image left, copy right) is restored at lg. */}
        {/* The inner wrapper is CENTRED below lg and flush left at lg.

            At lg this copy is the right-hand column of a two-column spread, so
            a 46ch measure ranged left against the photograph is correct. On a
            tablet the same block is the full width of the page, and that same
            measure left roughly 290px of empty green down the right-hand side
            — the text read as though it had failed to fill the page rather
            than as a set column. Centring the block turns that leftover width
            into two even margins, which is what the eye expects. */}
        <div class="order-1 flex flex-col justify-center px-6 pb-16 pt-28 md:px-14 md:pb-20 md:pt-32 lg:order-2 lg:px-20 lg:py-32 xl:px-28">
            <div class="mx-auto w-full max-w-2xl lg:mx-0 lg:max-w-none">
                <p data-animate class="eyebrow text-brass">{t.overview.eyebrow}</p>

                <h2
                    data-lines
                    class="display mt-6 max-w-[18ch] text-bone text-[clamp(1.75rem,3.4vw,2.9rem)]"
                >
                    <span class="line-mask"><span>{t.overview.heading}</span></span>
                </h2>

                <div
                    data-animate
                    data-animate-delay="0.1"
                    class="mt-10 h-px w-16 bg-brass"
                    aria-hidden="true"
                >
                </div>

                {/* Measure opens up slightly on tablet, where this paragraph is
                    the full width of the page rather than a column beside a
                    picture. */}
                <div class="mt-10 max-w-[46ch] space-y-6 text-[0.95rem] leading-[1.85] text-bone/70 md:max-w-[56ch] lg:max-w-[46ch]">
                    <p data-animate data-animate-delay="0.15">{t.overview.body1}</p>
                    <p data-animate data-animate-delay="0.22">{t.overview.body2}</p>
                </div>

                {/* Two-up between sm and lg. These are four short, unranked
                    labels; as a single column they left most of a tablet's
                    width empty and stretched the section by another screen.
                    They go back to one column at lg, where the copy is already
                    sharing the page with the photograph. */}
                <ul class="mt-14 grid gap-7 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-1">
                    {features.map((feature, i) => (
                        <li
                            data-animate
                            data-animate-delay={String(0.3 + i * 0.07)}
                            class="flex items-start gap-5"
                        >
                            <span class="mt-0.5 shrink-0 text-brass">
                                <FeatureIcon name={feature.key} class="h-9 w-9" />
                            </span>
                            <span class="pt-1.5 text-[0.9rem] leading-relaxed text-bone/80">
                                {feature.label}
                            </span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>
