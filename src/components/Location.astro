---
// Page 2: the illustrated Karuizawa map from the deck, shown as delivered.
//
// NOTHING IS DRAWN ON TOP OF IT, and that is the point. Read this before
// adding a marker.
//
// The artwork already labels itself. It carries a gold star in a white disc on
// the site, "OLD GINZA STREET" set in small caps beside its own shop icon,
// route shields for 133 and 18, the Shinkansen line, and a compass rose in the
// top-right corner. It was drawn as a finished piece of marketing material and
// it does not need help.
//
// Two overlays were built over it and both are now gone:
//
//   1. Inline text pills at percentage coordinates. `whitespace-nowrap` labels
//      with no boundary clamping, which ran off the edge of a narrow map in
//      every locale. Broken at any width.
//   2. Numbered badges (1/2/3) with a legend underneath and matching digits in
//      the travel-time list. Geometrically robust, and confusing: a reader had
//      to map a digit to a legend entry to a place, while the artwork was
//      already naming two of those places directly underneath. Two labelling
//      systems arguing over one picture.
//
// The compass overlay went with them for the same reason — the deck's own rose
// is right there in the corner, and we were drawing a second one on top of it.
//
// Karuizawa Station is the one place named in the travel list that the artwork
// does not label. That is fine: the list is a list, and it does not need a pin
// to be legible. `t.location.mapAlt` carries the full description for anyone
// who cannot see the image.
//
// The map keeps its framed presentation — bone mat, gold hairline, caption —
// which is shared with the survey drawing in Land.astro so the two technical
// plates on the page read as one family.
import Figure from './Figure.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const times = [
    t.location.times.ginza,
    t.location.times.station,
    t.location.times.tokyo,
    t.location.times.haneda,
] as Array<{ label: string; value: string; via?: string }>;
---

<section id="location" class="bg-bone-dim/60 py-24 md:py-32 lg:py-40">
    <div data-float-scene class="mx-auto max-w-shell px-6 md:px-10 lg:px-14">
        <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.45fr)] lg:gap-20 xl:gap-28">
            {/* Copy column */}
            <div data-float data-float-depth="0.18" class="lg:sticky lg:top-32 lg:self-start">
                <p data-animate class="eyebrow">{t.location.eyebrow}</p>

                <h2 data-lines class="display mt-6 max-w-[15ch] text-[clamp(1.75rem,3.4vw,2.9rem)]">
                    <span class="line-mask"><span>{t.location.heading}</span></span>
                </h2>

                <div data-animate data-animate-delay="0.1" class="mt-10 h-px w-16 bg-brass" aria-hidden="true"></div>

                <p
                    data-animate
                    data-animate-delay="0.15"
                    class="mt-10 max-w-[44ch] text-[0.95rem] leading-[1.85] text-ink/75"
                >
                    {t.location.body}
                </p>

                <dl class="mt-14 border-t border-ink/12">
                    {times.map((item, i) => (
                        <div
                            data-animate
                            data-animate-delay={String(0.2 + i * 0.06)}
                            class="flex items-baseline justify-between gap-6 border-b border-ink/12 py-5"
                        >
                            <dt class="text-[0.9rem] text-ink/75">
                                <span>
                                    {item.label}
                                    {item.via && (
                                        <span class="mt-1 block text-[0.7rem] tracking-[0.08em] text-stone">
                                            {item.via}
                                        </span>
                                    )}
                                </span>
                            </dt>
                            <dd class="shrink-0 font-serif text-lg tracking-[0.08em] text-ink">
                                {item.value}
                            </dd>
                        </div>
                    ))}
                </dl>

                <p data-animate data-animate-delay="0.45" class="mt-5 text-[0.7rem] leading-relaxed text-stone">
                    {t.location.note}
                </p>
            </div>

            {/* Map column — a framed plate, not a bare photo. */}
            {/* The map plate, brought into the same mounted language as the
                photographs elsewhere: a gold hairline instead of the grey one
                it carried, and a slow drift toward the pointer on desktop.

                The inner bone padding STAYS. This is a drawing on a light
                ground, and it needs a mat between the artwork and the mount or
                the gold sits directly against the map's own cream and the two
                warm tones fight. Photographs need no mat; drawings on paper do.

                No slow zoom here either — same reason as the survey plan in
                Land.astro. A map that scales is a map whose scale bar lies. */}
            <div data-animate data-animate-delay="0.1">
                <div data-float data-float-depth="0.4" class="relative">
                <div
                    data-reveal-img
                    data-reveal-delay="0.22"
                    aria-hidden="true"
                    class="pointer-events-none absolute -inset-[1.5px] hidden bg-brass lg:block"
                >
                </div>
                <div class="relative bg-bone p-3 shadow-[0_30px_60px_-30px_rgba(38,38,31,0.35)] sm:p-4">
                    {/* The declared size below is deliberately NOT the file's
                        real one. The image is 1761x1169 (3:2); this declares
                        4:3, and since Figure turns width/height into the
                        aspect-ratio it reserves, object-cover crops the sides
                        to fit.

                        That crop is wanted. It trims the empty forest margins
                        and brings the star and Old Ginza Street closer
                        together, which is what makes the map read at the size
                        it is shown here. The cost is the deck's compass rose in
                        the top-right corner, which is cropped off — checked,
                        and accepted.

                        Restoring the true 1761x1169 shows the whole artwork
                        including the rose, if that is ever preferred. */}
                    <div class="relative overflow-hidden">
                        <Figure
                            src="/images/location-map.jpg"
                            alt={t.location.mapAlt}
                            width={1600}
                            height={1200}
                            tone="stone"
                            class="w-full"
                            imgClass="h-full w-full object-cover"
                        />

                        {/* Two labels set ON the artwork, in the artwork's own
                            hand: serif caps, same size, same restraint. Text
                            only, no icons — the deck pairs its own label with a
                            shop glyph, but two more marks on a map this small
                            crowds it, and neither of these needs a symbol to be
                            understood.

                            ── The coordinates are percentages of the VISIBLE
                            BOX, not of the image file, and the two differ.
                            The plate is a 4:3 window onto a 3:2 image, so
                            object-cover trims about 6.5% off each side. The
                            star measures at 37.5% / 21.9% of the box; that
                            figure is stable at every width because the crop
                            ratio never changes, but it will be wrong the moment
                            the declared 1600x1200 or the map file changes.
                            Re-measure if either does.

                            ── Karuizawa Station sits just above the rail line
                            it names, and to the right of the route-18 shield.
                            Both of those are deliberate. The artwork does not
                            mark the station, so this is positioned from the
                            geography rather than copied from a symbol, and the
                            plate is captioned "not to scale" right beneath it.

                            Directly ON the line, at 94.5%, the chip covered the
                            18 shield and left 3px of clearance at the bottom of
                            the plate on a phone. Nudged up and right it clears
                            both and still reads as belonging to the line.

                            ── Both labels open to the RIGHT from a left anchor
                            and both start left of centre, so the text grows
                            into the map rather than towards an edge. That is
                            what stops this repeating the original bug, where
                            nowrap labels at percentage coordinates ran off the
                            side of a narrow map. */}
                        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
                            <span class="map-label" style="left:40.5%; top:21.9%">
                                {t.location.mapLabels.site}
                            </span>

                            <span class="map-label" style="left:55%; top:90.5%">
                                {t.location.mapLabels.station}
                            </span>
                        </div>
                    </div>
                </div>
                </div>

                <p class="mt-4 text-[0.7rem] leading-relaxed text-stone">
                    {t.location.mapCaption}
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* A small dark chip rather than text sitting directly on the artwork.

       The first version matched the deck's own "OLD GINZA STREET" mark — dark
       green caps with a white halo, drawn to look printed into the map. It
       reads beautifully across the flat cream of the town, and it thins out the
       moment a label crosses the tree wash or a pale road, because a hairline
       serif at this size has very little glyph mass to hold an edge with.

       The chip solves that outright: the text now brings its own background, so
       its legibility no longer depends on what is underneath it. The trade is
       that these two read as applied to the map rather than drawn into it,
       which is the honest description of what they are — the artwork does not
       label the station, so this was never going to be indistinguishable from
       it anyway.

       Kept deliberately restrained: no blur, no border, a small radius, and an
       opacity low enough that the map still shows through. */
    .map-label {
        position: absolute;
        display: block;
        transform: translateY(-50%);
        white-space: nowrap;
        padding: 0.2rem 0.44rem;
        border-radius: 2px;
        background: rgb(32 36 28 / 0.62);
        font-family: var(--font-serif);
        font-size: 0.6rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-bone);
        /* Lifts the chip off the map rather than lighting the glyphs — the
           background is doing the legibility work now. */
        box-shadow: 0 2px 8px rgb(20 23 17 / 0.28);
    }



    @media (width >= 40rem) {
        .map-label { font-size: 0.7rem; padding: 0.26rem 0.56rem; }
    }

    @media (width >= 64rem) {
        .map-label { font-size: 0.8rem; padding: 0.3rem 0.62rem; }
    }
</style>
